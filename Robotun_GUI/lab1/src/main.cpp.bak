// Define Pi locally to be perfectly robust
#ifndef M_PI
#define M_PI 3.14159265358979323846
#endif

static void glfw_error_callback(int error, const char* description)
{
    fprintf(stderr, "Glfw Error %d: %s\n", error, description);
}

// ----------------- PHYSICS MODEL DEFS -----------------

struct State {
    double dth;   // Angular velocity of pendulum (rad/s)
    double th;    // Pendulum angle (rad, 0 is vertical upright)
    double dphi;  // Angular velocity of wheel (rad/s)
    double phi;   // Wheel rotation angle (rad)
};

struct Params {
    double M = 1.5;     // Wheel mass (kg)
    double R = 0.3;     // Wheel radius (m)
    double m = 0.5;     // Pendulum mass (kg)
    double l = 0.8;     // Distance from wheel center to pendulum COM (m)
    double g = 9.81;    // Gravity (m/s^2)
    double cw = 0.1;    // Wheel damping coefficient
    double cp = 0.05;   // Pendulum joint damping coefficient
};

struct Vec3 {
    double x, y, z;
};

struct Camera3D {
    double yaw = -M_PI / 4.0; 
    double pitch = M_PI / 6.0; 
    double distance = 4.0;    
    Vec3 target = { 0.0, 0.5, 0.0 };
};

ImVec2 project3d(const Vec3& p, const Camera3D& cam, ImVec2 center, double scale_zoom) {
    double rx = p.x - cam.target.x;
    double ry = p.y - cam.target.y;
    double rz = p.z - cam.target.z;

    // 1. Rotate Y (yaw)
    double x1 = rx * cos(cam.yaw) - rz * sin(cam.yaw);
    double z1 = rx * sin(cam.yaw) + rz * cos(cam.yaw);

    // 2. Rotate X (pitch)
    double y2 = ry * cos(cam.pitch) - z1 * sin(cam.pitch);
    double z2 = ry * sin(cam.pitch) + z1 * cos(cam.pitch);

    // Distance relative to camera
    double dist = cam.distance - z2;
    if (dist < 0.1) dist = 0.1;

    float sx = (float)(center.x + (x1 * scale_zoom) / dist);
    float sy = (float)(center.y - (y2 * scale_zoom) / dist);
    return ImVec2(sx, sy);
}

enum class IntegratorType {
    Euler,
    RK4
};

// Compute dynamic derivatives of the system (Lagrangian equations of motion)
State get_derivatives(const State& state, const Params& p) {
    double th = state.th;
    double dth = state.dth;
    double dphi = state.dphi;
    double dx = dphi * p.R; // Wheel linear velocity

    // Effective wheel mass (including rotation, assuming disk: Me = M + I/R^2 = 1.5*M)
    double Me = 1.5 * p.M;
    
    // Pendulum moment of inertia about center of mass (assuming a thin rod of length 2*l)
    double Ip = (1.0 / 12.0) * p.m * (4.0 * p.l * p.l); 
    double Jp = Ip + p.m * p.l * p.l; // Parallel axis theorem

    // Formulate system of equations:
    // A * ddx + B * ddth = C
    // D * ddx + E * ddth = F
    double A = Me + p.m;
    double B = p.m * p.l * cos(th);
    double C = p.m * p.l * dth * dth * sin(th) - p.cw * dx / p.R;
    
    double D = p.m * p.l * cos(th);
    double E = Jp;
    double F = p.m * p.g * p.l * sin(th) - p.cp * dth;

    double det = A * E - B * D;
    if (std::abs(det) < 1e-9) det = 1e-9;

    double ddx = (C * E - B * F) / det;
    double ddth = (A * F - C * D) / det;
    double ddphi = ddx / p.R;

    State deriv;
    deriv.dth = ddth;
    deriv.th = dth;
    deriv.dphi = ddphi;
    deriv.phi = dphi;
    return deriv;
}

// Numerical Euler integration
State integrate_euler(const State& s, const Params& p, double dt) {
    State deriv = get_derivatives(s, p);
    State next;
    next.dth = s.dth + deriv.dth * dt;
    next.th = s.th + deriv.th * dt;
    next.dphi = s.dphi + deriv.dphi * dt;
    next.phi = s.phi + deriv.phi * dt;
    return next;
}

// Numerical Runge-Kutta 4th Order integration
State integrate_rk4(const State& s, const Params& p, double dt) {
    State k1 = get_derivatives(s, p);

    State s2;
    s2.dth = s.dth + k1.dth * dt * 0.5;
    s2.th = s.th + k1.th * dt * 0.5;
    s2.dphi = s.dphi + k1.dphi * dt * 0.5;
    s2.phi = s.phi + k1.phi * dt * 0.5;
    State k2 = get_derivatives(s2, p);

    State s3;
    s3.dth = s.dth + k2.dth * dt * 0.5;
    s3.th = s.th + k2.th * dt * 0.5;
    s3.dphi = s.dphi + k2.dphi * dt * 0.5;
    s3.phi = s.phi + k2.phi * dt * 0.5;
    State k3 = get_derivatives(s3, p);

    State s4;
    s4.dth = s.dth + k3.dth * dt;
    s4.th = s.th + k3.th * dt;
    s4.dphi = s.dphi + k3.dphi * dt;
    s4.phi = s.phi + k3.phi * dt;
    State k4 = get_derivatives(s4, p);

    State next;
    next.dth = s.dth + (k1.dth + 2.0 * k2.dth + 2.0 * k3.dth + k4.dth) * dt / 6.0;
    next.th = s.th + (k1.th + 2.0 * k2.th + 2.0 * k3.th + k4.th) * dt / 6.0;
    next.dphi = s.dphi + (k1.dphi + 2.0 * k2.dphi + 2.0 * k3.dphi + k4.dphi) * dt / 6.0;
    next.phi = s.phi + (k1.phi + 2.0 * k2.phi + 2.0 * k3.phi + k4.phi) * dt / 6.0;
    return next;
}

// History logging structure for real-time graphs
struct SimHistory {
    std::vector<float> time;
    std::vector<float> theta;
    std::vector<float> dth;
    std::vector<float> phi;
    size_t max_size = 1000;

    void add(float t, float th, float dt, float ph) {
        if (time.size() >= max_size) {
            time.erase(time.begin());
            theta.erase(theta.begin());
            dth.erase(dth.begin());
            phi.erase(phi.begin());
        }
        time.push_back(t);
        theta.push_back(th);
        dth.push_back(dt);
        phi.push_back(ph);
    }

    void clear() {
        time.clear();
        theta.clear();
        dth.clear();
        phi.clear();
    }
};

